# -------------------------------------------------------------
# DeepXis Music Bot — Environment Variables Configuration
# -------------------------------------------------------------

# Discord Application Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Spotify Web API Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# PostgreSQL Database Connection String
# e.g., postgresql://postgres:password@localhost:5432/deepxis_music
DATABASE_URL=postgresql://user:password@localhost:5432/deepxis_music

# Application & Server Settings
PORT=3000
NODE_ENV=development
EMBED_COLOR=#7C3AED
DEFAULT_VOLUME=80

# -------------------------------------------------------------
# Custom Visual Assets (Optional override via Environment)
# Provide Discord custom emoji (<:name:id> or <a:name:id>)
# or direct image/GIF CDN URL extracted from embed codes.
# Leave blank to use clean text-fallback labels.
# -------------------------------------------------------------
